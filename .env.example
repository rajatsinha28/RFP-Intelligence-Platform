# Copy this file to .env and add your real credentials. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Advance RAG
APP_API_KEY=
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

OPENAI_API_KEY=
OPENAI_BASE_URL=
FAST_MODEL=gpt-6-luna
ADVANCED_MODEL=gpt-6.1-sol
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
MAX_OUTPUT_TOKENS=1800
# Configure current provider prices to enable per-request cost estimates.
FAST_INPUT_COST_PER_MILLION=0
FAST_OUTPUT_COST_PER_MILLION=0
ADVANCED_INPUT_COST_PER_MILLION=0
ADVANCED_OUTPUT_COST_PER_MILLION=0

PINECONE_API_KEY=
PINECONE_INDEX=advance-rag
PINECONE_NAMESPACE=kb-default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_AUTO_CREATE=true
PINECONE_QUERY_TIMEOUT_SECONDS=20

POSTGRES_URL=postgresql+asyncpg://advance_rag:advance_rag@postgres:5432/advance_rag
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

STORAGE_PATH=/data/documents
MAX_UPLOAD_MB=50
WEB_MAX_DOWNLOAD_MB=25
WEB_FETCH_TIMEOUT_SECONDS=20
OCR_LANGUAGES=eng

CHUNK_STRATEGY=structure
CHUNK_SIZE=900
CHUNK_OVERLAP=120
MIN_CHUNK_SIZE=120
MAX_CHUNK_SIZE=1600
EMBEDDING_BATCH_SIZE=64

DENSE_TOP_K=30
BM25_TOP_K=30
RERANK_TOP_K=8
FINAL_CONTEXT_K=8
CONTEXT_NEIGHBOR_RADIUS=1
HYBRID_ALPHA=0.72
RRF_K=60
MMR_LAMBDA=0.72
SIMILARITY_THRESHOLD=0.22
ANSWERABILITY_HIGH_THRESHOLD=0.72
ANSWERABILITY_MEDIUM_THRESHOLD=0.48
MAX_RETRIEVAL_RETRIES=1

RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-base
COHERE_API_KEY=

CACHE_TTL_SECONDS=3600
EMBEDDING_CACHE_TTL_SECONDS=604800
SEMANTIC_CACHE_THRESHOLD=0.93
SEMANTIC_CACHE_MAX_CANDIDATES=250
MAX_CONTEXT_TOKENS=12000

RATE_LIMIT_PER_MINUTE=60
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=advance-rag
